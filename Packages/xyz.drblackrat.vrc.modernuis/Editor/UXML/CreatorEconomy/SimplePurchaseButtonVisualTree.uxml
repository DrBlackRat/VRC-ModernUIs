<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ModernUIs/Scripts/_Internals/EditorUIs/UXML/ModernUIStyle.uss?fileID=7433441132597879392&amp;guid=d6ca4da10a8b8e14b9d313a7713a9f73&amp;type=3#ModernUIStyle" />
    <ui:VisualElement name="Header" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Modern UI | Simple Purchase Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; opacity: 1; margin-top: 4px; font-size: 25px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; justify-content: flex-start; align-self: center; -unity-font-style: bold; white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="Info" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Allows to update UIs, play sounds effects and more based on if a player has purchased one or multiple Udon Products." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-text-align: middle-left; opacity: 1; margin-top: 2px; font-size: 14px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; justify-content: flex-start; align-self: auto; -unity-font-style: normal; white-space: normal; align-items: auto; text-overflow: clip; height: auto; flex-direction: column; flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-height: auto;" />
    </ui:VisualElement>
    <ui:Foldout text="Settings" view-data-key="SPBSettings" name="Settings" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="Product &amp; Whitelist" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="forceOwned" name="forceOwned" label="Force Own Products" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="requireAllProducts" name="requireAllProducts" label="Require Owning All Products" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="whitelist" name="whitelist" label="Prodcut Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="products" name="product" label="Udon Products" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Sound Effect" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="audioSource" name="audioSource" label="Audio Source" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="purchaseSound" name="purchaseSound" label="Purchase Sound" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="expiredSound" name="expiredSound" label="Expired Sound" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="External Connections" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="notOwnedObjects" name="notOwnedObjects" label="Not Owned Objects" style="-unity-font-style: normal; font-size: 12px;" />
            <uie:PropertyField binding-path="ownedObjects" name="ownedObjects" label="Owned Objects" style="-unity-font-style: normal; font-size: 12px;" />
            <uie:PropertyField binding-path="eventReceivers" name="ownedObjects" label="Event Receivers" style="-unity-font-style: normal; font-size: 12px; margin-top: 10px;" />
            <uie:PropertyField binding-path="onPurchaseEventName" name="onPurchaseEventName" label="On Purchase Event" style="-unity-font-style: normal; font-size: 12px; margin-top: 0;" />
            <uie:PropertyField binding-path="onExpiredEventName" name="onExpiredEventName" label="On Expired Event" style="-unity-font-style: normal; font-size: 12px; margin-top: 0;" />
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
