<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/DrBlackRat/ModernUIs/Scripts/_Internals/EditorUIs/UXML/ModernUIStyle.uss?fileID=7433441132597879392&amp;guid=d6ca4da10a8b8e14b9d313a7713a9f73&amp;type=3#ModernUIStyle" />
    <ui:VisualElement name="Header" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Modern UI | Whitelist Voice Control" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; opacity: 1; margin-top: 4px; font-size: 25px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; justify-content: flex-start; align-self: center; -unity-font-style: bold; white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="Info" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Allows adjusting the voice of players depending on if they are on a whitelist or not. &quot;Not Whitelisted Voice&quot; should usually be left to the default.&#10;&#10;&lt;b&gt;Notice:&lt;/b&gt; Having multiple systems in one world affecting player voices can cause problems." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" enable-rich-text="true" style="-unity-text-align: middle-left; opacity: 1; margin-top: 2px; font-size: 14px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; justify-content: flex-start; align-self: auto; -unity-font-style: normal; white-space: normal; align-items: auto; text-overflow: clip; height: auto; flex-direction: column; flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-height: auto;" />
    </ui:VisualElement>
    <ui:Foldout text="General" view-data-key="VoiceControlGeneral" name="VoiceControlGeneral" value="true" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <uie:PropertyField binding-path="whitelist" name="whitelist" label="Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="debugLogging" name="debugLogging" label="Debug Logging" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
    <ui:Foldout text="Voice Options" view-data-key="VoiceControlVoiceOptions" name="VoiceOptions" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="Whitelisted" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="whitelistedVoiceGain" name="whitelistedVoiceGain" label="Voice Gain" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="whitelistedNearDistance" name="whitelistedNearDistance" label="Near Distance" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="whitelistedFarDistance" name="whitelistedFarDistance" label="Far Distance" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="whitelistedVolumetricRadius" name="whitelistedVolumetricRadius" label="Volumetric Radius" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="whitelistedLowpass" name="whitelistedLowpass" label="Far Lowpass" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Not Whitelisted / Default" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="notWhitelistedVoiceGain" name="notWhitelistedVoiceGain" label="Voice Gain" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notWhitelistedNearDistance" name="notWhitelistedNearDistance" label="Near Distance" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notWhitelistedFarDistance" name="notWhitelistedFarDistance" label="Far Distance" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notWhitelistedVolumetricRadius" name="notWhitelistedVolumetricRadius" label="Volumetric Radius" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notWhitelistedLowpass" name="notWhitelistedLowpass" label="Far Lowpass" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
