<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ModernUIs/Scripts/_Internals/EditorUIs/UXML/ModernUIStyle.uss?fileID=7433441132597879392&amp;guid=d6ca4da10a8b8e14b9d313a7713a9f73&amp;type=3#ModernUIStyle" />
    <ui:VisualElement name="Header" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Modern UI | Join Leave Notification Sender" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; opacity: 1; margin-top: 4px; font-size: 25px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; justify-content: flex-start; align-self: center; -unity-font-style: bold; white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="Info" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Allows sending notifications for when players join or leave, can be limited to a whitelist or exclude the people on it." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-text-align: middle-center; opacity: 1; margin-top: 2px; font-size: 14px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; justify-content: flex-start; align-self: auto; -unity-font-style: normal; white-space: normal; align-items: auto; text-overflow: clip; height: auto; flex-direction: column; flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-height: auto;" />
    </ui:VisualElement>
    <ui:Foldout text="Settings" view-data-key="JoinLeaveNotificationsSettings" name="Settings" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="General" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="notificationManager" name="notificationManager" label="Notification Manager" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="showInHistory" name="showInHistory" label="Show In Notification History" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="sourceName" name="sourceName" label="Notification Source Name" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Whitelist" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="whitelist" name="whitelist" label="Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="invertWhitelist" name="invertWhitelist" label="Invert Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Show To Whitelist" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="sendToWhitelist" name="sendToWhitelist" label="Send To Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="invertSendToWhitelist" name="invertSendToWhitelist" label="Invert Send To Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
    <ui:Foldout text="Notification" view-data-key="JoinLeaveNotifications" name="Notification" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="Join Notification" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="showJoinNotification" name="showJoinNotification" label="Show Join Notifications" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="headerJoined" name="headerJoined" label="Join Header" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="messageJoined" name="messageJoined" label="Join Message" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="imageJoined" name="imageJoined" label="Join Image" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="playSoundJoined" name="playSoundJoined" label="Play Join Sound" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="soundClipJoined" name="soundClipJoined" label="Join Sound Clip" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="soundVolumeJoined" name="soundVolumeJoined" label="Join Sound Volume" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Leave Notification" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="showLeaveNotification" name="showLeaveNotification" label="Show Leave Notifications" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="headerLeft" name="headerLeft" label="Leave Header" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="messageLeft" name="messageLeft" label="Leave Message" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="imageLeft" name="imageLeft" label="Leave Image" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="playSoundLeft" name="playSoundLeft" label="Play Leave Sound" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="soundClipLeft" name="soundClipLeft" label="Leave Sound Clip" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="soundVolumeLeft" name="soundVolumeJoined" label="Leave Sound Volume" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="General" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="duration" name="duration" label="Duration" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="width" name="width" label="Width" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
