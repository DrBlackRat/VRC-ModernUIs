<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ModernUIs/Scripts/_Internals/EditorUIs/UXML/ModernUIStyle.uss?fileID=7433441132597879392&amp;guid=d6ca4da10a8b8e14b9d313a7713a9f73&amp;type=3#ModernUIStyle" />
    <ui:VisualElement name="Header" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Modern UI | Notification Manager" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; opacity: 1; margin-top: 4px; font-size: 25px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; justify-content: flex-start; align-self: center; -unity-font-style: bold; white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="Info" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Allows displaying notifications by using the provided API, will play them after each other if multiple are being send at the same time." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-text-align: middle-center; opacity: 1; margin-top: 2px; font-size: 14px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; justify-content: flex-start; align-self: auto; -unity-font-style: normal; white-space: normal; align-items: auto; text-overflow: clip; height: auto; flex-direction: column; flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-height: auto;" />
    </ui:VisualElement>
    <ui:Foldout text="Settings" view-data-key="NotificationMangerSettubgs" name="Settings" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="Queue" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="limitNotificationQueueLength" name="limitNotificationQueueLength" label="Limit Queue Length" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="maxNotificationQueueLength" name="maxNotificationQueueLength" label="Max Queue Length" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="History" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="notificationHistory" name="notificationHistory" label="Notifiation History" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="directlyAddToHistory" name="directlyAddToHistory" label="Directly Add To History" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Audio" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="notificationAudioSource" name="notificationAudioSource" label="Notification Audio Source" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="defaultAudioClip" name="defaultAudioClip" label="Default Audio Clip" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Animation" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="smoothingCurve" name="smoothingCurve" label="Smoothing Curve" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="startAnimDuration" name="startAnimDuration" label="Start Animation Time" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="endAnimDuration" name="endAnimDuration" label="End Animation Time" style="font-size: 12px; -unity-font-style: normal;" />
            <ui:Label tabindex="-1" text="Position &amp; Scale" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="shownPos" name="shownPos" label="Shown Pos" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="hiddenPos" name="hiddenPos" label="Hidden Pos" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="shownScale" name="shownScale" label="Shown Scale" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="fovScaleCurve" name="fovScaleCurve" label="FOV Scale Curve" focusable="false" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="hiddenScale" name="hiddenScale" label="Hidden Scale" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
    <ui:Foldout text="UI References" view-data-key="NotificationMangerUI" name="UIReferences" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <uie:PropertyField binding-path="notificationObject" name="notificationObject" label="Game Object" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notificationTransform" name="notificationTransform" label="Transform" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="canvasRootTransform" name="canvasRootTransform" label="Canvas Transform" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notificationHeaderObj" name="notificationHeaderObj" label="Header Obj" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notificationTextObj" name="notificationTextObj" label="Text Obj" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="imageContainer" name="imageContainer" label="Image Container Object" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="notificationImage" name="notificationImage" label="Image" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="countdownSlider" name="countdownSlider" label="Countdown Slider" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
