<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ModernUIs/Scripts/_Internals/EditorUIs/UXML/ModernUIStyle.uss?fileID=7433441132597879392&amp;guid=d6ca4da10a8b8e14b9d313a7713a9f73&amp;type=3#ModernUIStyle" />
    <ui:VisualElement name="Header" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Modern UI | Basic Net Notification Sender" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; opacity: 1; margin-top: 4px; font-size: 25px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; justify-content: flex-start; align-self: center; -unity-font-style: bold; white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="Info" class="section" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Label tabindex="-1" text="Allows setting up a networked notification in editor and then sending it by calling &quot;_SendNotification&quot;. Can optionally be provided with a whitelist of who should receive it." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="-unity-text-align: middle-center; opacity: 1; margin-top: 2px; font-size: 14px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; justify-content: flex-start; align-self: auto; -unity-font-style: normal; white-space: normal; align-items: auto; text-overflow: clip; height: auto; flex-direction: column; flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-height: auto;" />
    </ui:VisualElement>
    <ui:Foldout text="Settings" view-data-key="BasicNetNotificationSendSettings" name="Settings" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <ui:Label tabindex="-1" text="General" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 14px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 3px; margin-right: 0; margin-top: 5px;" />
            <uie:PropertyField binding-path="netNotificationRelay" name="netNotificationRelay" label="Net Notification Relay" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="receivingWhitelist" name="receivingWhitelist" label="Receiving Whitelist" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
    <ui:Foldout text="Notification" view-data-key="BasicNetNotificationSendNotificationSettings" name="Notification" class="section" style="font-size: 18px; -unity-font-style: bold; margin-left: 6px; padding-left: 20px;">
        <ui:VisualElement name="Elements" style="flex-grow: 1; padding-right: 0; margin-left: -30px;">
            <uie:PropertyField binding-path="header" name="header" label="Header" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="message" name="message" label="Message" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="imageId" name="imageId" label="Image Id" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="playSound" name="playSound" label="Play Sound Effect" style="font-size: 12px; -unity-font-style: normal; margin-top: 10px;" />
            <uie:PropertyField binding-path="soundClipId" name="soundClipId" label="Sound Clip Id" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="soundVolume" name="playSound" label="Volume" style="font-size: 12px; -unity-font-style: normal; margin-bottom: 10px;" />
            <uie:PropertyField binding-path="duration" name="duration" label="Duration" style="font-size: 12px; -unity-font-style: normal;" />
            <uie:PropertyField binding-path="width" name="width" label="Width" style="font-size: 12px; -unity-font-style: normal;" />
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
