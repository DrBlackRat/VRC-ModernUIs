      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "Modern UIs includes basic localization support through a dedicated
        Language Selector UI.\n\nPlayers can change their language in-game using
        the Selector UI, and by default the system will attempt to match the language
        selected in the user's VRChat settings.\n\nThe selected language can then
        be used in two different ways.\n\n<b>Localized Component</b>\n\n\u2022 Automatically
        switches content based on the selected language\n\u2022 Supports TextMeshPro
        text\n\u2022 Supports Sprite Renderers\n\u2022 Supports Materials\n\u2022
        Supports various other common Unity components\n\n<b>Custom Localized Component</b>\n\n\u2022
        Updates public strings and sprites on Udon behaviours\n\u2022 Sends an event
        after applying localized values\n\u2022 Allows other Udon behaviours to react
        to language changes\n\u2022 Useful for custom systems that require more advanced
        localization support"
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
