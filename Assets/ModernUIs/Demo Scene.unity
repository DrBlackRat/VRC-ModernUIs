        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -0.0006336639
      objectReference: {fileID: 0}
    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Size
      value: 0.34691307
      objectReference: {fileID: 0}
    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
