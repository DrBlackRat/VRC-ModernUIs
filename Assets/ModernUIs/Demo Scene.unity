    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Size
      value: 0.559806
      objectReference: {fileID: 0}
    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Value
      value: 1.0000029
      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "As mentioned in the Whitelist section, whitelists can originate from
        a variety of sources, including VRChat's Creator Economy.\n\nThis allows
        Creator Economy products to be used directly as permissions, making it easy
        to lock features and content behind supporter tiers, premium access, or other
        paid offerings.\n\n<b>Examples</b>\n\n\u2022 Toggles and Selector UIs\n\u2022
        Sliders and advanced settings\n\u2022 Restricted areas, rooms, and world
        features\n\u2022 Video Players through the AccessTXL integration\n\u2022
        Any other system that supports Modern UIs whitelists\n\n<b>Creator Economy
        Whitelist</b>\n\n\u2022 Uses VRChat Creator Economy products as a whitelist
        source\n\u2022 Players who own one of the specified products are considered
        whitelisted\n\u2022 Can be combined with other whitelist sources through
        Whitelist Combiners and Logic Combiners\n\u2022 Integrates seamlessly with
        throughout Modern UIs\n\n<b>Limitations</b>\n\n\u2022 Only players currently
        present in the instance can be detected"
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
