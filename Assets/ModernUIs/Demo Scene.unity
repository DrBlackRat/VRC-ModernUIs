    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Value
      value: 1.0000007
      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "Sometimes important notifications are easy to miss. For those situations,
        Modern UIs includes an optional Notification History system that keeps a
        record of previously received notifications.\n\nThis allows users to review
        past notifications at any time and provides additional information about
        when they were received or optionally who send them.\n\n<b>Features</b>\n\n\u2022
        View previously received notifications\n\u2022 Displays the time each notification
        was received\n\u2022 Shows the total number of notifications received\n\u2022
        Allows the notification history to be cleared\n\u2022 Integrates directly
        with the Notification Manager\n\u2022 Works with all systems that use the
        Notification API\n\nJust like most Modern UIs components, the Notification
        History is available as both a standalone UI and a Main UI Element."
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
