      value: 1.0000007
      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "Modern UIs includes a powerful Notification (Toast) system that allows
        both built-in and custom systems to send notifications directly to users.\n\nNotifications
        are managed through the Notification Manager, which automatically queues
        incoming notifications and displays them one after another.\n\n<b>Notification
        Features</b>\n\nEach notification can include:\n\u2022 Header / Title\n\u2022
        Message Content\n\u2022 Optional Image\n\u2022 Optional Notification Sound\n\u2022
        Custom Sound Clip\n\u2022 Custom Sound Volume\n\u2022 Custom Display Duration\n\u2022
        Custom Notification Width\n\u2022 Source Information\n\u2022 Optional Notification
        History Entry\n\n<b>Notification Queue</b>\n\n\u2022 Multiple notifications
        can be added at the same time\n\u2022 Notifications are automatically queued
        and displayed in order\n\u2022 Prevents notifications from overlapping or
        being missed\n\u2022 Notifications can be removed from the queue before being
        played\n\n<b>Notification API</b>\n\nOther Modern UIs systems make use of
        the Notification API to provide user feedback automatically.\n\n<b>Built-In
        Systems</b>\n\n\u2022 <b>Custom Network Notifications</b>\n    \u2022 Send
        notifications to specific players or users across the instance\n\n\u2022
        <b>Join / Leave Notifications</b>\n    \u2022 Display notifications when
        players join or leave\n    \u2022 Can be restricted to only show notifications
        for players on a specific whitelist\n\n\u2022 <b>Basic Notifications</b>\n   
        \u2022 Configured directly in the Unity Editor\n    \u2022 Can be triggered
        using a single Udon event\n\n\u2022 <b>Whitelist Add / Remove Notifications</b>\n   
        \u2022 Notify players when they are added to or removed from a whitelist\n   
        \u2022 Can also be used alongside Creator Economy permissions\n\n\u2022 <b>Whitelist
        Update Notifications</b>\n    \u2022 Notify users when players are added
        to or removed from a whitelist\n    \u2022 Useful for moderation, staff tools,
        and permission management\n\nThis makes notifications a central part of the
        user experience and provides a consistent way for systems to communicate
        important information to players."
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
