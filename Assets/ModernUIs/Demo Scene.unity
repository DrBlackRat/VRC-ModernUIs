        type: 3}
      propertyPath: m_Size
      value: 0.8994963
      objectReference: {fileID: 0}
    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Value
      value: 1.0000191
      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "The Permission Manager is an advanced whitelist management tool. While
        standard whitelist editors focus on a single whitelist, the Permission Manager
        allows you to view and manage multiple whitelists from a single interface.\n\nThis
        makes it ideal for moderation systems, staff tools, and other setups where
        multiple permissions need to be managed at the same time.\n\n<b>Features</b>\n\n\u2022
        Supports displaying and editing up to 8 whitelists simultaneously\n\u2022
        Provides a compact overview of player permissions across multiple whitelists\n\u2022
        Allows teleporting directly to listed players\nAllows enabling confirmation
        dialogs on a per-whitelist basis to help prevent accidental changes\n\u2022
        Makes it easy to compare and manage permissions without switching between
        menus\n\n<b>Limitations</b>\n\n\u2022 Only displays information for players
        who are currently present in the instance"
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
