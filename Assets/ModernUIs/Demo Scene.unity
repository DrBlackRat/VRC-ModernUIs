    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_Size
      value: 0.4529054
      objectReference: {fileID: 0}
    - target: {fileID: 4586130411077341659, guid: 86034297a83190f49ab0adafb47440cb,
