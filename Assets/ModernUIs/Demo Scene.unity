      propertyPath: m_Value
      value: 1.0000012
      objectReference: {fileID: 0}
    - target: {fileID: 5336956100140916112, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: "Modern UIs includes multiple ways to showcase and integrate VRChat
        Creator Economy products. These systems allow players to purchase products
        directly in-world, unlock features, and switch between paid options such
        as world designs, themes, etc.\n\n<b>Store Types</b>\n\n<b>Store Selector
        UI</b>\n\u2022 A Selector UI that requires players to own the corresponding
        product before they can switch to a state\n\u2022 Ideal for world themes,
        environments, special effects, and other unlockable options\n\u2022 Available
        in Local, Whitelist, Synced and Lockable variants\n\n<b>Simple Store</b>\n\u2022
        Displays listings / products in a compact storefront layout\n\u2022 Supports
        product images, pricing, and purchase actions\n\u2022 Designed for quick
        and easy purchasing\n\n<b>Detailed Store</b>\n\u2022 Displays each listing
        as its own dedicated section\n\u2022 Supports descriptions, images, pricing,
        and purchase actions\n\u2022 Includes a feature list with images, titles,
        and descriptions\n\u2022 Ideal for supporter tiers, bundles, memberships,
        and premium feature packages\n\n<b>Use Cases</b>\n\n\u2022 World themes and
        visual presets\n\u2022 Supporter and VIP tiers\n\u2022 Premium world features\n\u2022
        Bundles containing multiple benefits\n\u2022 Permission and access-based
        systems through whitelist integration"
      objectReference: {fileID: 0}
    - target: {fileID: 5757065297534502311, guid: 86034297a83190f49ab0adafb47440cb,
        type: 3}
      propertyPath: m_text
      value: Info
      objectReference: {fileID: 0}
